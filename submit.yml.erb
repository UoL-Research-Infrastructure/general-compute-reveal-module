---
batch_connect:
  template: vnc
  min_port: 18500
  max_port: 18599
script:
  native:
    - "-N"
    - "<%= bc_num_slots.blank? ? 1 : bc_num_slots.to_i %>"
    - "--mem"
    - "<%= custom_memory_per_node.blank? ? 2 : custom_memory_per_node.to_s %>G"
    - "-c"
    - "<%= custom_num_cores.blank? ? 1 : custom_num_cores.to_i %>"
    - "-p"
    - "<%= custom_queue %>"
