---
batch_connect:
  template: vnc
  min_port: 18500
  max_port: 18599
script:
  native:
    - "-N"
    - "<%= bc_num_slots.blank? ? 1 : bc_num_slots.to_i %>"
    - "--mem"
    - "<%= custom_memory.blank? ? 2 : custom_memory.to_s %>G"
    - "-c"
    - "<%= custom_cpus.blank? ? 1 : custom_cpus.to_i %>"
    - "-p"
    - "<%= custom_queue %>"
